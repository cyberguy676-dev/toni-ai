# GEMINI_API_KEY: Required for Gemini AI API calls (Server-side only — never exposed in frontend code).
# Set this in your Render Environment Variables dashboard or AI Studio Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Secret key used for signing HMAC-SHA256 authentication tokens on the server.
SESSION_SECRET="toni-ai-random-session-secret-change-me"

# PORT: Server port (Render automatically injects PORT at runtime; defaults to 3000 locally).
PORT="3000"

# APP_URL: Public URL where this app is hosted.
APP_URL="MY_APP_URL"
